{
  "name": "dsh-blender-annotate",
  "version": "0.1.2",
  "private": true,
  "description": "Preview and annotate Blender .blend files in DeepSeek Harness: click any point to get its object, instance, source face, nearest edge and vertex, in-face parameters, UV and coordinates, add a comment, sketch on the view, and send it all to the chat.",
  "type": "module",
  "license": "MIT",
  "author": "iimaguest (fork of dsh-preview-blender and dsh-preview-snip by 439436269-ctrl)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "blender",
    "blend",
    "gltf",
    "annotation",
    "3d"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.py",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-resources"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "fixture": "tmp=$(mktemp -d) && blender -b --factory-startup --python test/fixtures/make_fixture.py -- \"$tmp/fixture.blend\" && blender -b --disable-autoexec \"$tmp/fixture.blend\" --python lib/scene.py -- test/fixtures/annotate-fixture.glb test/fixtures/annotate-fixture.json 1 && rm -rf \"$tmp\"",
    "test:independent": "node --test test/independent/*.test.js",
    "test:all": "node --test test/*.test.js test/independent/*.test.js test/final-qa/*.test.js"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iimaguest/dsh-blender-annotate.git"
  },
  "homepage": "https://github.com/iimaguest/dsh-blender-annotate#readme",
  "bugs": {
    "url": "https://github.com/iimaguest/dsh-blender-annotate/issues"
  }
}
